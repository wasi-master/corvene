<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="100" maximum="900" default="400">
      <map input="100" output="20"/>
      <map input="400" output="80"/>
      <map input="700" output="140"/>
      <map input="900" output="180"/>
    </axis>
    <axis tag="opsz" name="Optical size" values="14 32" default="14"/>
  </axes>
  <rules>
    <rule name="heavy dollar">
      <conditionset>
        <condition name="Weight" minimum="120" maximum="180"/>
      </conditionset>
      <sub name="dollar" with="dollar.rvrn"/>
    </rule>
  </rules>
  <sources>
    <source filename="Sample-Regular.ufo" name="Sample Regular" familyname="Corvene Sample" stylename="Regular">
      <location>
        <dimension name="Weight" xvalue="80"/>
        <dimension name="Optical size" xvalue="14"/>
      </location>
    </source>
    <source filename="Sample-Bold.ufo" name="Sample Bold" familyname="Corvene Sample" stylename="Bold">
      <location>
        <dimension name="Weight" xvalue="140"/>
        <dimension name="Optical size" xvalue="14"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance name="Sample Regular" familyname="Corvene Sample" stylename="Regular" filename="instances/Sample-Regular.ufo">
      <location>
        <dimension name="Weight" uservalue="400"/>
        <dimension name="Optical size" uservalue="14"/>
      </location>
    </instance>
    <instance name="Sample Medium" familyname="Corvene Sample" stylename="Medium" filename="instances/Sample-Medium.ufo">
      <location>
        <dimension name="Weight" uservalue="500"/>
        <dimension name="Optical size" uservalue="14"/>
      </location>
    </instance>
    <instance name="Sample Bold" familyname="Corvene Sample" stylename="Bold" filename="instances/Sample-Bold.ufo">
      <location>
        <dimension name="Weight" uservalue="700"/>
        <dimension name="Optical size" uservalue="14"/>
      </location>
    </instance>
  </instances>
</designspace>
